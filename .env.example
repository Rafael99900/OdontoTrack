# Copie este arquivo para .env.local no desenvolvimento. Nunca versione .env.local.
# Os valores abaixo são marcadores deliberadamente inválidos, não são credenciais.

# Obrigatória somente para a rota de IA. Sem ela, POST /api/ia/perguntar responde 503.
GEMINI_API_KEY=cole_a_chave_do_servidor_aqui

# Reservadas para OT-01. Tornam-se obrigatórias quando autenticação, banco ou Storage
# do Supabase forem implementados. A service role nunca deve usar prefixo NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_a_chave_anon_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_apenas_no_servidor_aqui

# URL pública canônica, usada por links e callbacks de autenticação quando OT-01 existir.
NEXT_PUBLIC_APP_URL=http://localhost:3000
